{
  "$id": "https://schema.opencerts.io/certificate-of-awards/2.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Certificate of Award (W3C Verifiable Credential)",
  "description": "W3C Verifiable Credentials Data Model 2.0 representation of an OpenCerts certificate of award, for use with the TrustVC (@trustvc/trustvc) library.",
  "type": "object",
  "definitions": {
    "issuer": {
      "description": "W3C VC issuer: a URI/DID string, or an object describing the issuing organisation. Replaces the OpenAttestation \"issuers\" array. The W3C VC v2 context marks \"issuer\" as @protected, so context.json declares these as top-level terms rather than scoping them under \"issuer\".",
      "oneOf": [
        { "type": "string", "format": "uri" },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "description": "DID or URL identifying the issuer; replaces the OpenAttestation issuer \"did\"",
              "examples": ["did:web:opencerts.io:moe"]
            },
            "name": { "type": "string", "examples": ["Ministry of Education"] },
            "uen": {
              "type": "string",
              "description": "unique entity number of the issuing organisation",
              "examples": ["U18274928E"]
            },
            "url": { "type": "string", "examples": ["https://www.moe.gov.sg"] },
            "email": { "type": "string", "examples": ["registrar@moe.gov.sg"] }
          },
          "required": ["id", "name", "uen"],
          "additionalProperties": false
        }
      ]
    },
    "credentialSubject": {
      "type": "object",
      "description": "The certificate of award data.",
      "properties": {
        "id": {
          "type": "string",
          "description": "identifier of the recipient (DID/URL), when known"
        },
        "type": {
          "description": "the credential subject type; must be (or include) \"CertificateOfAward\", because context.json defines the terms inside that type-scoped @context",
          "oneOf": [
            { "const": "CertificateOfAward" },
            {
              "type": "array",
              "items": { "type": "string" },
              "contains": { "const": "CertificateOfAward" }
            }
          ]
        },
        "name": {
          "type": "string",
          "description": "name of the award or participated course/activity",
          "examples": [
            "Edusave Award for Achievement, Good Leadership and Service (EAGLES) 2017"
          ]
        },
        "description": {
          "type": "string",
          "description": "certificate information"
        },
        "recipient": {
          "type": "object",
          "description": "information about the person that is receiving the certificate of award",
          "properties": {
            "name": {
              "type": "string",
              "description": "recipient name on certificate",
              "examples": ["John Doe"]
            },
            "nric": { "type": "string", "examples": ["S1234567J"] },
            "fin": { "type": "string", "examples": ["F1234567E"] },
            "studentId": {
              "type": "string",
              "description": "student number issued by training centre",
              "examples": ["12345"]
            }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "award": {
          "type": "object",
          "properties": {
            "instituteName": {
              "type": "string",
              "description": "school or institute name",
              "examples": ["ABC Junior College"]
            },
            "achievementArea": {
              "type": "string",
              "description": "name of CCA/CIP/project/competition and achievement"
            },
            "achievementYear": {
              "type": "string",
              "description": "achievement/graduation year",
              "pattern": "^[0-9]{4}$",
              "examples": ["2016"]
            },
            "achievementDate": {
              "type": "string",
              "format": "date",
              "description": "exact date of achievement/graduation",
              "examples": ["2016-11-21"]
            }
          },
          "anyOf": [
            { "required": ["achievementYear"] },
            { "required": ["achievementDate"] }
          ],
          "additionalProperties": false
        },
        "additionalData": {
          "type": "object",
          "description": "freeform issuer data. Declared as \"@type\": \"@json\" in context.json, so its contents are carried verbatim and may be arbitrarily nested without each field being declared."
        },
        "signature": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "signee name",
              "examples": ["Vikram Nair"]
            },
            "designation": {
              "type": "string",
              "description": "signee designation"
            },
            "signatureImage": {
              "type": "string",
              "description": "signee base64 image signature"
            },
            "seal": {
              "type": "string",
              "description": "signee base64 image seal"
            }
          },
          "required": ["name"],
          "additionalProperties": false
        }
      },
      "required": ["type", "name", "recipient", "award", "signature"],
      "additionalProperties": false
    }
  },
  "properties": {
    "@context": {
      "type": "array",
      "description": "JSON-LD contexts. The first entry must be the W3C VC v2.0 context.",
      "minItems": 1,
      "items": [
        { "const": "https://www.w3.org/ns/credentials/v2" }
      ],
      "additionalItems": { "type": ["string", "object"] }
    },
    "id": {
      "type": "string",
      "format": "uri",
      "description": "credential identifier. GENERATED, not supplied: TrustVC mints a urn:uuid at signing time and rejects a document that already carries an \"id\". It is therefore only valid on a signed credential (one that has a \"proof\"), which the conditional below enforces.",
      "examples": ["urn:uuid:0198e4a3-b601-7117-9d02-8c9a9a54ab5d"]
    },
    "type": {
      "type": "array",
      "description": "credential types; must include VerifiableCredential",
      "items": { "type": "string" },
      "contains": { "const": "VerifiableCredential" }
    },
    "issuer": { "$ref": "#/definitions/issuer" },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "description": "the date and time from which the credential is valid (replaces issuedOn)"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "description": "the date and time after which the credential is no longer valid"
    },
    "credentialSubject": { "$ref": "#/definitions/credentialSubject" },
    "credentialStatus": {
      "type": "object",
      "description": "Bitstring Status List entry (W3C VC Data Model 2.0), used to revoke or suspend the credential. All four of type/statusPurpose/statusListIndex/statusListCredential are needed — a partial entry is rejected at signing time.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "description": "identifier of this status entry",
          "examples": ["https://opencerts.io/status/1#42"]
        },
        "type": {
          "type": "string",
          "enum": ["BitstringStatusListEntry"]
        },
        "statusPurpose": {
          "type": "string",
          "enum": ["revocation", "suspension"],
          "description": "what setting this bit means"
        },
        "statusListIndex": {
          "description": "position of this credential's bit in the status list; a non-negative integer, expressed as a string per the Bitstring Status List spec",
          "oneOf": [
            { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
            { "type": "integer", "minimum": 0 }
          ],
          "examples": ["42"]
        },
        "statusListCredential": {
          "type": "string",
          "format": "uri",
          "description": "absolute URL of the status list credential",
          "examples": ["https://opencerts.io/status/1"]
        }
      },
      "required": [
        "type",
        "statusPurpose",
        "statusListIndex",
        "statusListCredential"
      ]
    },
    "credentialSchema": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "type": "string" } },
          "required": ["type"]
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "type": { "type": "string" } },
            "required": ["type"]
          }
        }
      ]
    },
    "renderMethod": {
      "type": "array",
      "description": "How a viewer should render the credential. Replaces the OpenAttestation \"$template\": url -> id, type -> type, name -> templateName.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uri",
            "description": "URL of a decentralised renderer to render this document",
            "examples": ["https://demo-renderer.opencerts.io"]
          },
          "type": {
            "type": "string",
            "description": "Type of renderer template",
            "enum": ["EMBEDDED_RENDERER"]
          },
          "templateName": {
            "type": "string",
            "description": "Template name to be used by the template renderer to determine the template to use",
            "examples": ["CERTIFICATE_OF_AWARD"]
          }
        },
        "required": ["id", "type", "templateName"]
      }
    },
    "proof": { "type": "object" }
  },
  "required": [
    "@context",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject"
  ],
  "additionalProperties": true,
  "if": { "not": { "required": ["proof"] } },
  "then": {
    "not": { "required": ["id"] },
    "$comment": "An unsigned credential must not carry an \"id\": TrustVC generates it while signing and refuses any document that already has one."
  }
}
