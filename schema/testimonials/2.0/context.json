{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "opencerts": "https://schema.opencerts.io/vocab#",
    "schema": "https://schema.org/",
    "Testimonial": {
      "@id": "opencerts:Testimonial",
      "@type": "@id",
      "@context": {
        "@protected": true,
        "name": "schema:name",
        "description": "schema:description",
        "content": {
          "@id": "opencerts:content",
          "@type": "@json"
        },
        "recipient": {
          "@id": "opencerts:recipient",
          "@context": {
            "@protected": true,
            "name": "schema:name",
            "nric": "opencerts:nric",
            "fin": "opencerts:fin",
            "studentId": "opencerts:studentId"
          }
        },
        "testimonial": {
          "@id": "opencerts:testimonial",
          "@context": {
            "@protected": true,
            "role": "opencerts:role",
            "instituteName": "opencerts:instituteName",
            "achievementArea": "opencerts:achievementArea",
            "achievementYear": "opencerts:achievementYear",
            "achievementDate": "opencerts:achievementDate"
          }
        },
        "referee": {
          "@id": "opencerts:referee",
          "@context": {
            "@protected": true,
            "name": "schema:name",
            "designation": "opencerts:designation",
            "signatureImage": "opencerts:signatureImage",
            "seal": "opencerts:seal",
            "email": "schema:email",
            "relationship": "opencerts:relationship"
          }
        }
      }
    }
  }
}
